<Window x:Class="AAIIMoocPC.DirectCourseDetailWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
 Title="Course Player" Width="1120" Height="860" MinWidth="900" MinHeight="700" WindowStartupLocation="CenterOwner">
 <Grid Background="#F4F7FB">
  <Grid.RowDefinitions>
   <RowDefinition Height="74"/>
   <RowDefinition Height="420"/>
   <RowDefinition Height="*"/>
  </Grid.RowDefinitions>

  <Border Background="#14141C">
   <Grid Margin="22,10">
    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
    <StackPanel>
     <TextBlock x:Name="TitleText" Text="Course" Foreground="White" FontSize="23" FontWeight="Bold" TextTrimming="CharacterEllipsis"/>
     <TextBlock x:Name="CategoryText" Foreground="#B9E9E4" FontSize="12"/>
    </StackPanel>
    <Border Grid.Column="1" Background="#20364A" CornerRadius="12" Padding="12,8" VerticalAlignment="Center">
     <TextBlock Text="▶  In-App Video Player" Foreground="#E6FFFB" FontWeight="SemiBold"/>
    </Border>
   </Grid>
  </Border>

  <Border Grid.Row="1" Margin="22,16,22,10" Background="#0B1220" CornerRadius="18" BorderBrush="#233044" BorderThickness="1">
   <Grid ClipToBounds="True">
    <Grid.RowDefinitions><RowDefinition Height="52"/><RowDefinition Height="*"/></Grid.RowDefinitions>
    <Grid Grid.Row="0" Background="#111827">
     <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
     <StackPanel Margin="16,8" VerticalAlignment="Center">
      <TextBlock x:Name="PlayerTitle" Text="Choose a video lesson" Foreground="White" FontSize="15" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
      <TextBlock x:Name="PlayerStatus" Text="YouTube and Google Drive videos open here inside the software." Foreground="#94A3B8" FontSize="11" TextTrimming="CharacterEllipsis"/>
     </StackPanel>
     <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="8,6,12,6">
      <Button x:Name="ReloadButton" Content="↻ Reload" Click="Reload_Click" Padding="12,6" Margin="3"/>
      <Button x:Name="ExternalButton" Content="↗ Open External" Click="External_Click" Padding="12,6" Margin="3"/>
     </StackPanel>
    </Grid>

    <Grid Grid.Row="1" Background="#000000">
     <wv2:WebView2 x:Name="Player"/>
     <Border x:Name="PlayerPlaceholder" Background="#0B1220">
      <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="580">
       <TextBlock Text="▶" Foreground="#5EEAD4" FontSize="54" HorizontalAlignment="Center"/>
       <TextBlock Text="Select a lesson below" Foreground="White" FontSize="21" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,8,0,5"/>
       <TextBlock Text="YouTube and Google Drive preview links will play in this window. If a Drive file is private, sign in or change its sharing permission." Foreground="#94A3B8" FontSize="13" TextAlignment="Center" TextWrapping="Wrap"/>
      </StackPanel>
     </Border>
    </Grid>
   </Grid>
  </Border>

  <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
   <StackPanel x:Name="Body" Margin="22,6,22,24"/>
  </ScrollViewer>
 </Grid>
</Window>
